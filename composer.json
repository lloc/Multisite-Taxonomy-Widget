{
  "name": "lloc/multisite-taxonomy-widget",
  "description": "Multisite Taxonomy Widget",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "homepage": "https://it.wordpress.org/plugins/multisite-taxonomy-widget/",
  "require": {
    "php": ">=7.4",
    "composer/installers": "^v2.3"
  },
  "require-dev": {
    "brain/monkey": "^2.6",
    "phpunit/phpunit": "^10.5",
    "lloc/composer-i18n-scripts": "^1.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^1.12",
    "szepeviktor/phpstan-wordpress": "^1.3",
    "wp-coding-standards/wpcs": "^3.3"
  },
  "autoload": {
    "psr-4": {
      "lloc\\Mtw\\": "includes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "lloc\\MtwTests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "phpstan": "vendor/bin/phpstan analyze --memory-limit=1G",
    "coverage": "php -d xdebug.mode=coverage vendor/bin/phpunit --coverage-html tests/coverage",
    "phpcs": "vendor/bin/phpcs .",
    "phpcbf": "vendor/bin/phpcbf .",
    "git-release": "bin/git-release.sh",
    "build": [
      "@composer update --no-dev",
      "@git-release"
    ],
    "githooks": [
      "if [ -e ./bin/githooks/pre-commit ]; then cp ./bin/githooks/pre-commit ./.git/hooks/; fi",
      "if [ -e ./.git/hooks/pre-commit ]; then chmod 0755 ./.git/hooks/pre-commit; fi"
    ],
    "post-install-cmd": [
      "@githooks"
    ],
    "post-update-cmd": [
      "@githooks"
    ]
  },
  "authors": [
    {
      "name": "Dennis Ploetner",
      "email": "re@lloc.de",
      "homepage": "http://lloc.de"
    }
  ],
  "keywords": [
    "multisite",
    "taxonomy",
    "widget",
    "category",
    "recent posts"
  ],
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true,
      "lloc/composer-i18n-scripts": true
    }
  }
}
